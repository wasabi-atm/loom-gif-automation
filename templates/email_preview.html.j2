<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>GIF embed preview — {{ company or 'prospect' }}</title>
  </head>
  <body style="margin:0;padding:32px;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#18181b;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td align="center">
          <table role="presentation" width="{{ width }}" cellpadding="0" cellspacing="0" border="0"
                 style="width:100%;max-width:{{ width }}px;background:#ffffff;border-radius:8px;padding:28px;">
            <tr><td style="font-size:15px;line-height:1.55;padding-bottom:18px;">{{ body_before or 'Body copy sits here. The email has to read completely with images off.' }}</td></tr>
            <tr><td style="padding-bottom:18px;">{{ embed|safe }}</td></tr>
            <tr><td style="font-size:15px;line-height:1.55;">{{ body_after or 'Sign-off.' }}</td></tr>
          </table>
          <p style="font-size:12px;color:#71717a;max-width:{{ width }}px;text-align:left;margin-top:18px;">
            Preview only — not for sending. Outlook 2007–2019 shows frame one of the GIF, so frame one
            has to make sense on its own.
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
