# ---------------------------------------------------------------------------
# ImageKit — media hosting / CDN
# Dashboard: https://imagekit.io/dashboard/developer/api-keys
# ---------------------------------------------------------------------------
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/motiontheagency
IMAGEKIT_PUBLIC_KEY=<your public key>
IMAGEKIT_PRIVATE_KEY=<your private key — server-side only, never commit>
# Folder inside ImageKit where campaign media lands
IMAGEKIT_FOLDER=/outreach/loom-gif

# ---------------------------------------------------------------------------
# Instantly.ai — used to write the hosted URLs back onto each lead as
# custom variables, so the email body can reference {{gif_url}} etc.
# API key: Instantly > Settings > Integrations > API (V2 key)
# ---------------------------------------------------------------------------
INSTANTLY_API_KEY=
INSTANTLY_API_BASE=https://api.instantly.ai/api/v2

# ---------------------------------------------------------------------------
# Creative defaults (all overridable per-run on the CLI)
# ---------------------------------------------------------------------------
# A single clip, or a directory of takes to rotate between per prospect.
FACECAM_PATH=assets/facecam

# Auto-exposure: the FACE REGION of each clip is measured once and lifted to
# this luma. Reading the whole frame lets a bright window hide a dark face.
# Never darkens — a clip that is already bright is left alone.
FACECAM_AUTO_EXPOSURE=1
FACECAM_TARGET_LUMA=150
# Set FACECAM_GAMMA to a number to skip the measurement and force a value.
FACECAM_GAMMA=auto
FACECAM_BRIGHTNESS=0.02
FACECAM_CONTRAST=1.16
FACECAM_SATURATION=1.10

# Bubble shape: squircle (default) or circle. No ring or shadow is drawn.
FACECAM_SHAPE=squircle

# Soft drop shadow behind the bubble. 0 opacity turns it off.
FACECAM_SHADOW_OPACITY=0.30
FACECAM_SHADOW_BLUR_RATIO=0.085
FACECAM_SHADOW_OFFSET_RATIO=0.035
CANVAS_WIDTH=1280
CANVAS_HEIGHT=720
# auto = match the face cam clip exactly. Or set a number of seconds.
DURATION=auto
FPS=24

# How far down the page the scroll travels (0-1). Lower = calmer + smaller GIF.
SCROLL_RATIO=0.5
# Cap the capture in CSS px; marketing pages run to 15,000px.
MAX_CAPTURE_HEIGHT=3600
# Pin a solid sticky header as its own layer, like a real recording. 0 to disable.
PIN_STICKY_NAV=1

# Where a GIF click should send the prospect (a real Loom, a booking page, etc.)
# {{company}} / {{slug}} are substituted per prospect.
CLICK_THROUGH_URL=https://motiontheagency.com/

GIF_WIDTH=400
UPLOAD_ASSETS=gif
