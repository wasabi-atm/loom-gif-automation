# ---------------------------------------------------------------------------
# ImageKit — media hosting / CDN
# Dashboard: https://imagekit.io/dashboard/developer/api-keys
# ---------------------------------------------------------------------------
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/motiontheagency
IMAGEKIT_PUBLIC_KEY=<your public key>
IMAGEKIT_PRIVATE_KEY=<your private key — server-side only, never commit>
# Folder inside ImageKit where campaign media lands
IMAGEKIT_FOLDER=/outreach/loom-gif

# ---------------------------------------------------------------------------
# Instantly.ai — used to write the hosted URLs back onto each lead as
# custom variables, so the email body can reference {{gif_url}} etc.
# API key: Instantly > Settings > Integrations > API (V2 key)
# ---------------------------------------------------------------------------
INSTANTLY_API_KEY=
INSTANTLY_API_BASE=https://api.instantly.ai/api/v2

# ---------------------------------------------------------------------------
# Creative defaults (all overridable per-run on the CLI)
# ---------------------------------------------------------------------------
FACECAM_PATH=assets/facecam/facecam.mp4
CANVAS_WIDTH=1280
CANVAS_HEIGHT=720
DURATION=6
FPS=24

# How far down the page the scroll travels (0-1). Lower = calmer + smaller GIF.
SCROLL_RATIO=0.5
# Cap the capture in CSS px; marketing pages run to 15,000px.
MAX_CAPTURE_HEIGHT=3600

# Where a GIF click should send the prospect (a real Loom, a booking page, etc.)
# {{company}} / {{slug}} are substituted per prospect.
CLICK_THROUGH_URL=https://motiontheagency.com/
